# Copia este archivo a .env.local (desarrollo) o configura estas variables en tu hosting (producción).
# Las NEXT_PUBLIC_* y CSP_MODE se fijan AL COMPILAR: si cambian, vuelve a desplegar (en Docker, a compilar).
# Guía de despliegue: docs/DEPLOY.md

# ─── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Orígenes extra con acceso CORS a /api (la app nativa usa estos por defecto)
CORS_ALLOWED_ORIGINS=capacitor://localhost,https://localhost,http://localhost

# ─── Supabase (Project Settings → API) ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Llave secreta (sb_secret_...) o service_role heredada. Solo servidor, nunca en el cliente.
# La usan "Eliminar cuenta" (Google Play lo exige) y, con DOCUMENT_STORAGE=supabase, Storage.
SUPABASE_SECRET_KEY=
# "on" muestra «Continuar con Google» en la web (activa antes el proveedor Google en Supabase)
NEXT_PUBLIC_GOOGLE_AUTH=

# ─── Base de datos (Project Settings → Database → Connect) ────────────
# Runtime: transaction pooler (puerto 6543)
DATABASE_URL=postgresql://postgres.TU-PROYECTO:CONTRASENA@aws-0-REGION.pooler.supabase.com:6543/postgres
# Migraciones y scripts: session pooler (5432) o conexión directa
DIRECT_URL=postgresql://postgres.TU-PROYECTO:CONTRASENA@aws-0-REGION.pooler.supabase.com:5432/postgres

# ─── IA (Anthropic) ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FREE=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_PRO=claude-sonnet-5-5

# ─── Cifrado de tokens OAuth/bancarios (openssl rand -base64 32). Obligatoria en producción ──
TOKEN_ENCRYPTION_KEY=

# ─── Stripe (web): plan Pro de US$19.99 al mes ────────────────────────
# sk_test_... para probar; sk_live_... en producción (la app avisa en los logs si queda en modo de prueba)
STRIPE_SECRET_KEY=
# Secreto del endpoint https://TU-DOMINIO/api/webhooks/stripe (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Precio mensual recurrente del plan Pro (price_...)
STRIPE_PRICE_PRO_MONTHLY=

# ─── RevenueCat (Android / Google Play Billing) ───────────────────────
# Valor exacto que configures como "Authorization header" del webhook
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_PRO_ENTITLEMENT=pro
# Llave pública del SDK para Android (goog_...). La usa la pantalla de Omni Pro dentro de la app nativa.
NEXT_PUBLIC_REVENUECAT_ANDROID_KEY=

# ─── Conector financiero ───────────────────────────────────────────────
# sandbox = bancos y tarjetas simulados (por defecto). plaid = Plaid real con tus credenciales.
FINANCE_PROVIDER=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_COUNTRY_CODES=US
# Déjalo vacío por ahora: el receptor de webhooks de Plaid está en la hoja de ruta
PLAID_WEBHOOK_URL=

# ─── Trámites: dónde se guardan los PDF (formularios y copias llenas) ──
# database = tabla document_blobs en Postgres (por defecto, sin configurar nada)
# supabase = bucket privado "documents" de Supabase Storage (lo crea npm run db:security; usa SUPABASE_SECRET_KEY)
DOCUMENT_STORAGE=database

# ─── Compras: rastreador de precios ───────────────────────────────────
# on = lee páginas públicas de productos (se identifica como OmniAgentBot y respeta robots.txt)
# off = solo las tiendas de prueba (.test)
WEB_PRICE_CHECKS=on
# Página que explica el rastreador; va en su User-Agent. Vacío = NEXT_PUBLIC_APP_URL/bot
SCRAPER_CONTACT_URL=

# ─── Tareas programadas ───────────────────────────────────────────────
# Vercel Cron, Supabase pg_cron (npm run db:cron) o el programador de Docker envían
# "Authorization: Bearer CRON_SECRET". Genéralo con: openssl rand -hex 32
CRON_SECRET=
# Solo para npm run db:cron: URL pública que llamará Supabase (vacío = NEXT_PUBLIC_APP_URL)
CRON_TARGET_URL=

# ─── Producción: logs, errores y seguridad ────────────────────────────
# debug | info | warn | error (por defecto: info en producción, debug en desarrollo)
LOG_LEVEL=
# json (una línea por evento, para Vercel, Docker o tu agregador) | pretty. Vacío = json en producción
LOG_FORMAT=
# Opcional: webhook entrante de Slack o Discord para enterarte de los errores 5xx (sin datos de usuarios)
ERROR_WEBHOOK_URL=
# Content-Security-Policy en producción: enforce (por defecto) | report-only (para probar algo nuevo) | off
CSP_MODE=enforce
# Versión que muestra /api/health (en Vercel se toma del commit si no la defines)
APP_VERSION=
# Docker: 1 genera el servidor mínimo .next/standalone (el Dockerfile ya lo activa)
BUILD_STANDALONE=

# ─── Galería /preview con datos de ejemplo (siempre activa en desarrollo) ──
ENABLE_PREVIEW=false

# ─── Capacitor (modo hosted): URL pública HTTPS de la web desplegada ──
CAP_SERVER_URL=
