{
  "name": "omniagent",
  "version": "0.5.0",
  "private": true,
  "description": "OmniAgent: agente personal con IA para finanzas, trámites y compras.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:security": "node scripts/db-sql.mjs prisma/sql/supabase-setup.sql",
    "db:cron": "node scripts/db-cron.mjs",
    "db:studio": "prisma studio",
    "cap:add": "cap add android",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@revenuecat/purchases-capacitor": "^13.4.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.75.0",
    "dotenv": "^17.0.0",
    "imapflow": "^2.0.0",
    "lucide-react": "^1.40.0",
    "mailparser": "^3.7.0",
    "next": "^16.0.0",
    "nodemailer": "^7.0.0",
    "papaparse": "^5.4.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "pg": "^8.13.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "stripe": "^22.6.0",
    "web-push": "^3.6.7",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/mailparser": "^3.4.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": ">=6.4.17",
    "@types/papaparse": "^5.3.14",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/web-push": "^3.6.4",
    "prisma": "^7.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
