  /// "Visa de prueba •••• 4242": nunca se guarda el número completo de una tarjeta.
  paymentLabel    String      @map("payment_label")
  paymentRef      String?     @map("payment_ref")
  orderNumber     String?     @map("order_number")
  failureReason   String?     @map("failure_reason")
  /// Entrega, boletos y recibo.
  details         Json        @default("{}")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  item     WatchlistItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  action   AgentAction    @relation(fields: [actionId], references: [id], onDelete: Cascade)
  tracking TrackedOrder?

  @@index([userId, createdAt(sort: Desc)])
  @@map("purchase_orders")
}

