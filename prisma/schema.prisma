  currency          String      @default("USD") @db.Char(3)
  currentPrice      Decimal?    @map("current_price") @db.Decimal(14, 2)
  targetPrice       Decimal?    @map("target_price") @db.Decimal(14, 2)
  lowestPrice       Decimal?    @map("lowest_price") @db.Decimal(14, 2)
  dropAlertPct      Int         @default(15) @map("drop_alert_pct")
  checkEveryMinutes Int         @default(1440) @map("check_every_minutes")
  lastCheckedAt     DateTime?   @map("last_checked_at") @db.Timestamptz(6)
  nextCheckAt       DateTime?   @map("next_check_at") @db.Timestamptz(6)
