  endsAt          DateTime?         @map("ends_at") @db.Timestamptz(6)
  allDay          Boolean           @default(false) @map("all_day")
  reminderMinutes Int[]             @default([30]) @map("reminder_minutes")
  status          String            @default("confirmed") // confirmed | cancelled
  /// Versión del evento para el feed ICS (sube con cada cambio).
  sequence        Int               @default(0)
  externalEventId String?           @map("external_event_id")
  syncStatus      SyncStatus        @default(LOCAL_ONLY) @map("sync_status")
  syncError       String?           @map("sync_error")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
