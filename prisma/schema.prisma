// OmniAgent: esquema relacional (PostgreSQL en Supabase) con Prisma 7.
// Convenciones: tablas y columnas en snake_case, ids UUID, dinero en Decimal(14,2), fechas timestamptz.
// profiles.id = auth.users.id (el alta la hace un trigger; ver prisma/sql/supabase-setup.sql).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum Plan {
  FREE
  PRO

  @@map("plan")
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  EXPIRED
  INCOMPLETE

  @@map("subscription_status")
}

enum BillingProvider {
  STRIPE
  REVENUECAT
  BINANCE

  @@map("billing_provider")
}

enum IntegrationProvider {
  GOOGLE
  MICROSOFT
  BANK_AGGREGATOR
  BANK_DEMO
  MAIL_DEMO // bandeja y calendario de prueba (sandbox con el contrato de Gmail/Outlook)
  MAIL_IMAP // correo real por IMAP/SMTP con contraseña de aplicación (Gmail, Yahoo, iCloud…)

  @@map("integration_provider")
}

enum ConnectionStatus {
  ACTIVE
  EXPIRED
  REVOKED
  ERROR

  @@map("connection_status")
}

enum AgentModule {
  GENERAL
  FINANCE
  PROCEDURES
  CONCIERGE
  GOALS

  @@map("agent_module")
}

/// Categoría de un recuerdo del agente (ver src/modules/memory/memory.types.ts).
enum MemoryKind {
  PREFERENCE // cómo quiere que Omni trabaje o le hable
  FINANCE // datos de dinero que el banco conectado no muestra
  WEBSITE // páginas o sitios web que creó
  GOAL // metas y aspiraciones
  NOTE // otros datos duraderos (familia, trabajo, negocio)

  @@map("memory_kind")
}

/// Quién guardó el recuerdo.
enum MemorySource {
  USER // la persona, desde Cuenta
  AGENT // Omni, en el chat, con lo que la persona dijo
  SYSTEM // la app, al importar o sincronizar

  @@map("memory_source")
}

enum MessageRole {
  USER
  ASSISTANT
  TOOL

  @@map("message_role")
}

enum ActionType {
  CANCEL_SUBSCRIPTION
  SEND_EMAIL
  CREATE_CALENDAR_EVENT
  SUBMIT_FORM
  PURCHASE

  @@map("action_type")
}

enum ActionStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
  FAILED
  EXPIRED

  @@map("action_status")
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  WALLET
  OTHER

  @@map("account_type")
}

enum TransactionDirection {
  DEBIT
  CREDIT

  @@map("transaction_direction")
}

enum ChargeCadence {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY

  @@map("charge_cadence")
}

enum RecurringStatus {
  ACTIVE
  UNUSED_SUSPECTED
  CANCELLATION_REQUESTED
  CANCELED

  @@map("recurring_status")
}

enum SuggestionType {
  ANT_EXPENSE
  UNUSED_SUBSCRIPTION
  PRICE_DROP
  TASK_DUE
  GOAL_TIP
  GENERAL

  @@map("suggestion_type")
}

enum SuggestionStatus {
  NEW
  ACCEPTED
  DISMISSED

  @@map("suggestion_status")
}

enum ImportStatus {
  UPLOADED
  PROCESSING
  PARSED
  FAILED

  @@map("import_status")
}

enum TaskType {
  FORM_FILL
  EMAIL
  APPOINTMENT
  REMINDER
  DOCUMENT
  OTHER

  @@map("task_type")
}

enum TaskStatus {
  SUGGESTED // detectado (p. ej. en un correo), espera la confirmación de un toque
  PENDING
  IN_PROGRESS
  WAITING_USER
  DONE
  CANCELED

  @@map("task_status")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH

  @@map("task_priority")
}

enum DocumentKind {
  FORM_TEMPLATE
  FILLED_FORM
  STATEMENT
  RECEIPT
  OTHER

  @@map("document_kind")
}

enum MailCategory {
  FORM // formulario o permiso por llenar
  APPOINTMENT // cita con fecha y hora
  REIMBURSEMENT // reembolso o reclamo
  BILL // factura o pago con vencimiento
  DEADLINE // trámite con fecha límite (renovaciones, devoluciones...)
  EVENT // evento o reunión
  INFO // informativo, sin acción
  PROMO // publicidad

  @@map("mail_category")
}

enum CalendarEventKind {
  EVENT // cita o evento
  DEADLINE // fecha límite de un trámite (todo el día)
  FOCUS // bloque sugerido para hacer el trámite

  @@map("calendar_event_kind")
}

enum SyncStatus {
  LOCAL_ONLY
  PENDING
  SYNCED
  ERROR

  @@map("sync_status")
}

enum WatchKind {
  PRODUCT
  FLIGHT
  EVENT_TICKET
  HOTEL
  OTHER

  @@map("watch_kind")
}

enum WatchStatus {
  ACTIVE
  PAUSED
  PURCHASED
  ARCHIVED

  @@map("watch_status")
}

enum PriceAlertStatus {
  NEW // sin ver
  SEEN
  ACTED // el usuario preparó la compra desde la alerta
  DISMISSED
  EXPIRED

  @@map("price_alert_status")
}

enum OrderStatus {
  PLACED // pago autorizado (simulado) y pedido confirmado
  FAILED // pago rechazado
  CANCELED

  @@map("order_status")
}

enum GoalCategory {
  SAVINGS
  HEALTH
  FAMILY
  HOME
  TRAVEL
  CAREER
  OTHER

  @@map("goal_category")
}

enum GoalStatus {
  ACTIVE
  PAUSED
  ACHIEVED
  ABANDONED

  @@map("goal_status")
}

enum NotificationType {
  PRICE_DROP
  ACTION_REQUIRED
  INSIGHT
  REMINDER
  SYSTEM

  @@map("notification_type")
}

enum RecommendationKind {
  CANCEL_SUBSCRIPTION
  REDUCE_ANT_EXPENSES
  CATEGORY_BUDGET
  AVOID_FEES
  NEGOTIATE_BILL
  SAVINGS_GOAL
  OTHER

  @@map("recommendation_kind")
}

enum RecommendationStatus {
  NEW
  ACCEPTED
  DISMISSED
  DONE
  EXPIRED

  @@map("recommendation_status")
}

enum Difficulty {
  EASY
  MEDIUM
  HARD

  @@map("difficulty")
}

enum AnalysisSource {
  AI
  RULES

  @@map("analysis_source")
}

enum AnalysisTrigger {
  MANUAL
  CONNECTION
  SCHEDULED
  CHAT

  @@map("analysis_trigger")
}

enum ShipmentStatus {
  ORDERED // pedido confirmado, sin aviso de envío
  SHIPPED // en camino
  DELIVERED // entregado
  CANCELED // cancelado por la tienda o por el usuario

  @@map("shipment_status")
}

enum OrderSource {
  OMNIAGENT // comprado con la hoja de pago de OmniAgent
  EMAIL // detectado en un correo de la tienda o de la paquetería
  MANUAL // agregado por el usuario (en Devoluciones o en el chat)
  EXAMPLE // pedido de ejemplo en tiendas de prueba (.test)

  @@map("order_source")
}

enum ReturnReason {
  LATE // no llegó en la fecha prometida
  NOT_RECEIVED // figura entregado o se perdió, y no llegó
  DAMAGED // llegó dañado o no funciona
  WRONG_ITEM // otro producto, talla o color
  NOT_AS_DESCRIBED // no es como lo anunciaban
  CHANGED_MIND // ya no lo quiere (si la tienda acepta devoluciones)

  @@map("return_reason")
}

enum ReturnCaseStatus {
  DRAFT // Omni lo preparó: espera tu aprobación o que lo envíes tú
  SENT // enviado a la tienda, esperando respuesta
  ANSWERED // la tienda respondió y falta un paso tuyo (enviar el paquete, mandar fotos)
  RESOLVED // reembolso, cambio, saldo a favor o el pedido llegó
  REJECTED // la tienda lo rechazó
  CLOSED // lo cerraste tú

  @@map("return_case_status")
}

enum ReturnOutcome {
  REFUND
  REPLACEMENT
  STORE_CREDIT
  ARRIVED

  @@map("return_outcome")
}

enum ReturnChannel {
  EMAIL // Omni lo envía desde tu correo conectado, con tu aprobación
  MANUAL // lo envías tú (portal, chat o teléfono de la tienda) con el texto que prepara Omni

  @@map("return_channel")
}

// ───────────────────────── Usuarios y planes ─────────────────────────

model Profile {
  id                  String   @id @db.Uuid // = auth.users.id
  email               String?
  fullName            String?  @map("full_name")
  avatarUrl           String?  @map("avatar_url")
  locale              String   @default("es")
  timezone            String   @default("UTC")
  currency            String   @default("USD") @db.Char(3)
  stripeCustomerId    String?  @unique @map("stripe_customer_id")
  onboardingCompleted Boolean  @default(false) @map("onboarding_completed")
  preferences         Json     @default("{}")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscriptions     Subscription[]
  binanceOrders     BinanceOrder[]
  pushSubscriptions PushSubscription[]
  connections       IntegrationConnection[]
  usageLogs         AiUsageLog[]
  conversations     Conversation[]
  messages          Message[]
  actions           AgentAction[]
  financialAccounts FinancialAccount[]
  transactions      Transaction[]
  recurringCharges  RecurringCharge[]
  suggestions       Suggestion[]
  statementImports  StatementImport[]
  tasks             Task[]
  documents         UserDocument[]
  calendarEvents    CalendarEvent[]
  watchlist         WatchlistItem[]
  goals             Goal[]
  notifications     AppNotification[]
  auditLogs         AuditLog[]
  analyses          FinancialAnalysis[]
  recommendations   SavingsRecommendation[]
  budgets           CategoryBudget[]
  mailMessages      MailMessage[]
  personalFields    PersonalField[]
  calendarFeed      CalendarFeed?
  priceAlerts       PriceAlert[]
  orders            PurchaseOrder[]
  trackedOrders     TrackedOrder[]
  returnCases       ReturnCase[]
  contentReports    ContentReport[]
  memories          AgentMemory[]

  @@map("profiles")
}

/// Suscripción de pago unificada: Stripe (web) y RevenueCat (Google Play).
model Subscription {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String             @map("user_id") @db.Uuid
  provider               BillingProvider
  plan                   Plan               @default(PRO)
  status                 SubscriptionStatus
  productId              String?            @map("product_id")
  providerCustomerId     String?            @map("provider_customer_id")
  providerSubscriptionId String             @map("provider_subscription_id")
  currentPeriodEnd       DateTime?          @map("current_period_end") @db.Timestamptz(6)
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubscriptionId])
  @@index([userId, status])
  @@map("subscriptions")
}

/// Órdenes de Binance Pay. Cada una compra meses de Omni Pro por adelantado (no hay renovación automática):
/// al confirmarse el pago, la suscripción BINANCE de la persona se extiende esos meses.
model BinanceOrder {
  merchantTradeNo String    @id @map("merchant_trade_no")
  userId          String    @map("user_id") @db.Uuid
  months          Int
  amount          Decimal   @db.Decimal(12, 2)
  currency        String    @default("USDT")
  prepayId        String?   @map("prepay_id")
  /// PENDING, PAID, CANCELED, EXPIRED o ERROR (los estados de Binance que cierran la orden).
  status          String    @default("PENDING")
  paidAt          DateTime? @map("paid_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("binance_orders")
}

/// Registro idempotente de webhooks (Stripe y RevenueCat reintentan).
model BillingEvent {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider    BillingProvider
  eventId     String          @map("event_id")
  type        String
  userId      String?         @map("user_id") @db.Uuid
  payload     Json
  processedAt DateTime?       @map("processed_at") @db.Timestamptz(6)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([provider, eventId])
  @@map("billing_events")
}

// ───────────────────── Conexiones e IA ─────────────────────

/// Tokens de terceros (Google, Microsoft, agregador bancario). Siempre cifrados con AES-256-GCM.
model IntegrationConnection {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String              @map("user_id") @db.Uuid
  provider              IntegrationProvider
  externalAccountId     String?             @map("external_account_id")
  displayName           String?             @map("display_name")
  scopes                String[]            @default([])
  accessTokenEncrypted  String?             @map("access_token_encrypted")
  refreshTokenEncrypted String?             @map("refresh_token_encrypted")
  tokenExpiresAt        DateTime?           @map("token_expires_at") @db.Timestamptz(6)
  status                ConnectionStatus    @default(ACTIVE)
  lastSyncedAt          DateTime?           @map("last_synced_at") @db.Timestamptz(6)
  metadata              Json                @default("{}")
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user              Profile            @relation(fields: [userId], references: [id], onDelete: Cascade)
  financialAccounts FinancialAccount[]
  calendarEvents    CalendarEvent[]
  mailMessages      MailMessage[]

  @@unique([userId, provider, externalAccountId])
  @@map("integration_connections")
}

/// Consumo de IA por turno de conversación (sirve para cuotas del plan y costos).
model AiUsageLog {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String      @map("user_id") @db.Uuid
  conversationId  String?     @map("conversation_id") @db.Uuid
  module          AgentModule @default(GENERAL)
  kind            String      @default("chat") // chat | analysis
  model           String
  inputTokens     Int         @default(0) @map("input_tokens")
  outputTokens    Int         @default(0) @map("output_tokens")
  cacheReadTokens Int         @default(0) @map("cache_read_tokens")
  toolCalls       Int         @default(0) @map("tool_calls")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  user         Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("ai_usage_logs")
}

model Conversation {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  module    AgentModule @default(GENERAL)
  title     String?
  archived  Boolean     @default(false)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      Profile             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  actions   AgentAction[]
  usageLogs AiUsageLog[]
  analyses  FinancialAnalysis[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("conversations")
}

/// Memoria del agente: lo que Omni recuerda de cada persona entre conversaciones. `data` sigue el esquema de su
/// categoría (memory.types.ts) y `dedupeKey` (categoría + título normalizado, o la dirección de la página web) evita
/// duplicados. Solo el servidor la lee y la escribe; la persona la ve y la borra en Cuenta.
model AgentMemory {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  kind           MemoryKind
  title          String
  data           Json         @default("{}")
  dedupeKey      String       @map("dedupe_key")
  importance     Int          @default(2) @db.SmallInt // 1 baja, 2 media, 3 alta
  pinned         Boolean      @default(false)
  source         MemorySource @default(AGENT)
  /// Conversación donde Omni lo guardó (sin llave foránea: la conversación se puede borrar).
  conversationId String?      @map("conversation_id") @db.Uuid
  useCount       Int          @default(0) @map("use_count")
  lastUsedAt     DateTime?    @map("last_used_at") @db.Timestamptz(6)
  expiresAt      DateTime?    @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, kind])
  @@map("agent_memories")
}

/// content guarda lo que ve la UI: { text, cards[] }. Los mensajes TOOL registran cada llamada a herramienta.
model Message {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  role           MessageRole
  text           String?
  content        Json        @default("{}")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports      ContentReport[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

/// Respuesta de la IA reportada por quien la recibió (ofensiva, peligrosa, incorrecta...). Google Play exige que se pueda
/// reportar sin salir de la app; el desarrollador las revisa en esta tabla. Una por persona y mensaje.
model ContentReport {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  messageId String?  @map("message_id") @db.Uuid
  /// offensive | dangerous | sexual | wrong | privacy | other
  reason    String
  comment   String?
  /// Texto de la respuesta al momento del reporte (hasta 2,000 caracteres), por si después se borra la conversación.
  excerpt   String
  /// open | reviewed
  status    String   @default("open")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@unique([userId, messageId])
  @@index([status, createdAt])
  @@map("content_reports")
}

/// Todo lo que gasta, envía o cancela pasa por aquí: el agente propone, el usuario aprueba y el servidor ejecuta.
model AgentAction {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  conversationId String?      @map("conversation_id") @db.Uuid
  module         AgentModule
  type           ActionType
  status         ActionStatus @default(PENDING)
  title          String
  summary        String?
  payload        Json         @default("{}")
  amount         Decimal?     @db.Decimal(14, 2)
  currency       String?      @db.Char(3)
  result         Json?
  errorMessage   String?      @map("error_message")
  expiresAt      DateTime?    @map("expires_at") @db.Timestamptz(6)
  decidedAt      DateTime?    @map("decided_at") @db.Timestamptz(6)
  executedAt     DateTime?    @map("executed_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  order        PurchaseOrder?
  returnCases  ReturnCase[]

  @@index([userId, status, createdAt(sort: Desc)])
  @@map("agent_actions")
}

// ───────────────────── Módulo financiero ─────────────────────

model FinancialAccount {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String      @map("user_id") @db.Uuid
  connectionId    String?     @map("connection_id") @db.Uuid
  institutionName String      @map("institution_name")
  name            String
  type            AccountType @default(CHECKING)
  subtype         String?
  mask            String?     @db.VarChar(4)
  currency        String      @default("USD") @db.Char(3)
  currentBalance  Decimal?    @map("current_balance") @db.Decimal(14, 2)
  creditLimit     Decimal?    @map("credit_limit") @db.Decimal(14, 2)
  isSimulated     Boolean     @default(false) @map("is_simulated")
  externalId      String?     @map("external_id")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user             Profile                @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection       IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  transactions     Transaction[]
  /// Estados de cuenta importados (solo cuentas manuales, sin connectionId).
  statementImports StatementImport[]

  @@unique([userId, externalId])
  @@map("financial_accounts")
}

/// amount siempre positivo; direction indica si sale (DEBIT) o entra (CREDIT).
model Transaction {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String               @map("user_id") @db.Uuid
  accountId         String               @map("account_id") @db.Uuid
  externalId        String?              @map("external_id")
  postedAt          DateTime             @map("posted_at") @db.Timestamptz(6)
  amount            Decimal              @db.Decimal(14, 2)
  direction         TransactionDirection
  currency          String               @default("USD") @db.Char(3)
  merchantName      String?              @map("merchant_name")
  description       String
  category          String?
  subcategory       String?
  pending           Boolean              @default(false)
  recurringChargeId String?              @map("recurring_charge_id") @db.Uuid
  /// Estado de cuenta del que salió el movimiento; al deshacer la importación se borra con ella.
  statementImportId String?              @map("statement_import_id") @db.Uuid
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  user            Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account         FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  recurringCharge RecurringCharge? @relation(fields: [recurringChargeId], references: [id], onDelete: SetNull)
  statementImport StatementImport? @relation(fields: [statementImportId], references: [id], onDelete: Cascade)

  @@unique([accountId, externalId])
  @@index([userId, postedAt(sort: Desc)])
  @@index([userId, merchantName])
  @@index([statementImportId])
  @@map("transactions")
}

/// Suscripciones y cargos recurrentes detectados en los movimientos.
model RecurringCharge {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  merchantName    String          @map("merchant_name")
  category        String?
  subcategory     String?
  amount          Decimal         @db.Decimal(14, 2)
  currency        String          @default("USD") @db.Char(3)
  cadence         ChargeCadence
  status          RecurringStatus @default(ACTIVE)
  firstSeenAt     DateTime?       @map("first_seen_at") @db.Timestamptz(6)
