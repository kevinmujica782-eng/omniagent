// ───────────────────── Trámites y productividad ─────────────────────

model Task {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  type          TaskType     @default(OTHER)
  status        TaskStatus   @default(PENDING)
  priority      TaskPriority @default(MEDIUM)
  title         String
  notes         String?
  dueAt         DateTime?    @map("due_at") @db.Timestamptz(6)
  /// Cuándo hacerlo: bloque sugerido antes de la fecha límite, sin chocar con el calendario.
  plannedAt     DateTime?    @map("planned_at") @db.Timestamptz(6)
  remindAt      DateTime?    @map("remind_at") @db.Timestamptz(6)
  /// Cuándo se entregó el recordatorio (evita avisos duplicados).
  remindedAt    DateTime?    @map("reminded_at") @db.Timestamptz(6)
  confirmedAt   DateTime?    @map("confirmed_at") @db.Timestamptz(6)
  completedAt   DateTime?    @map("completed_at") @db.Timestamptz(6)
  mailMessageId String?      @map("mail_message_id") @db.Uuid
  source        String       @default("user") // user | agent | email
  /// Plan sugerido (pasos, evento, respuesta) y datos detectados.
  metadata      Json         @default("{}")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user           Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  mailMessage    MailMessage?    @relation(fields: [mailMessageId], references: [id], onDelete: SetNull)
  documents      UserDocument[]
  calendarEvents CalendarEvent[]

  @@unique([userId, mailMessageId])
  @@index([userId, status, dueAt])
  @@index([status, remindAt])
  @@map("tasks")
}

/// Documentos (PDF de formularios, copias rellenadas). El binario vive en Supabase Storage
/// (bucket privado "documents", ruta {userId}/...) o, sin Storage configurado, en document_blobs.
model UserDocument {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  taskId        String?      @map("task_id") @db.Uuid
  parentId      String?      @map("parent_id") @db.Uuid // copia rellenada → formulario original
  kind          DocumentKind @default(OTHER)
  fileName      String       @map("file_name")
  mimeType      String       @map("mime_type")
  sizeBytes     Int          @default(0) @map("size_bytes")
  source        String       @default("upload") // upload | email | generated
  storageDriver String       @default("database") @map("storage_driver") // database | supabase
  storagePath   String       @map("storage_path")
  /// Formulario: campos detectados y valores sugeridos. Copia rellenada: valores usados (sin firma).
  extractedData Json?        @map("extracted_data")
  extractedAt   DateTime?    @map("extracted_at") @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user           Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  task           Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  parent         UserDocument?   @relation("FilledCopies", fields: [parentId], references: [id], onDelete: SetNull)
  copies         UserDocument[]  @relation("FilledCopies")
  blob           DocumentBlob?
  mailAttachment MailAttachment?

  @@index([userId, createdAt(sort: Desc)])
  @@map("documents")
}

/// Binario de documentos pequeños cuando no hay Supabase Storage configurado. Sin acceso desde el cliente.
model DocumentBlob {
  documentId String   @id @map("document_id") @db.Uuid
  bytes      Bytes
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  document UserDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_blobs")
}

model CalendarEvent {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  taskId          String?           @map("task_id") @db.Uuid
  connectionId    String?           @map("connection_id") @db.Uuid
  kind            CalendarEventKind @default(EVENT)
  title           String
  description     String?
  location        String?
