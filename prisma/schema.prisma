  updatedAt           DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("goals")
}

// ───────────────────── Transversales ─────────────────────

model AppNotification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  body      String?
  href      String?
  data      Json             @default("{}")
  readAt    DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

/// Notificaciones push (Web Push) de cada teléfono o navegador donde la persona las activó.
model PushSubscription {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String?   @map("user_agent")
  failures      Int       @default(0)
  lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// Ajustes que el servidor genera solo y guarda cifrados (por ejemplo, las llaves VAPID de las notificaciones push).
model AppSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("app_settings")
}

/// Contadores de límite de tasa por ventana fija (solo servidor: RLS sin políticas).
model RateLimit {
  key         String
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
  @@map("rate_limits")
}

model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  actor     String // user | agent | system | webhook
  action    String
  entity    String?
  entityId  String?  @map("entity_id")
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user Profile? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ───────────────────── Pedidos y devoluciones ─────────────────────

/// Pedido que Omni sigue hasta que llega: comprado con OmniAgent, detectado en el correo o agregado a mano.
model TrackedOrder {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String         @map("user_id") @db.Uuid
  source           OrderSource
  /// Llave de origen para no duplicar: "mail:SMX-88213", "example:audifonos"… (null en los agregados a mano).
  sourceKey        String?        @map("source_key")
  purchaseOrderId  String?        @unique @map("purchase_order_id") @db.Uuid
  merchant         String
  /// Dominio de la tienda ("sonidomax.test"): sirve para reconocer sus correos y respuestas.
  merchantDomain   String?        @map("merchant_domain")
  /// A dónde reclamar por correo, si la tienda atiende así.
  supportEmail     String?        @map("support_email")
  orderNumber      String?        @map("order_number")
  title            String
  total            Decimal?       @db.Decimal(14, 2)
  currency         String         @default("USD") @db.Char(3)
  status           ShipmentStatus @default(ORDERED)
  orderedAt        DateTime       @map("ordered_at") @db.Timestamptz(6)
  /// Último momento del día prometido (fin del día, hora local).
  expectedBy       DateTime?      @map("expected_by") @db.Timestamptz(6)
  deliveredAt      DateTime?      @map("delivered_at") @db.Timestamptz(6)
  /// Días para devolver desde la entrega (política de la tienda; null si no se conoce).
  returnWindowDays Int?           @map("return_window_days")
  carrier          String?
  trackingNumber   String?        @map("tracking_number")
  /// Aviso de retraso ya enviado (se reclama de forma atómica: nunca se avisa dos veces).
  lateNotifiedAt   DateTime?      @map("late_notified_at") @db.Timestamptz(6)
  /// Correos de los que salió, última estimación de la paquetería y otros datos.
  meta             Json           @default("{}")
  /// "No le hagas seguimiento": deja de contar para retrasos y avisos.
  dismissedAt      DateTime?      @map("dismissed_at") @db.Timestamptz(6)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  cases         ReturnCase[]

  @@unique([userId, sourceKey])
  @@index([userId, status])
  @@index([userId, orderedAt(sort: Desc)])
  @@map("tracked_orders")
}

/// Reclamo o devolución de un pedido: qué pasó, el mensaje a la tienda, sus respuestas y el resultado.
model ReturnCase {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  orderId          String           @map("order_id") @db.Uuid
  reason           ReturnReason
  status           ReturnCaseStatus @default(DRAFT)
  channel          ReturnChannel
  /// Lo que pide el usuario: reembolso, cambio, saldo a favor o que el pedido llegue.
  desired          ReturnOutcome    @default(REFUND)
  details          String?
  /// Mensaje preparado para la tienda.
  subject          String
  body             String
  sendTo           String?          @map("send_to")
  /// Propuesta de envío vigente (agent_actions): el reclamo o el último seguimiento.
  actionId         String?          @map("action_id") @db.Uuid
  sentAt           DateTime?        @map("sent_at") @db.Timestamptz(6)
  followUps        Int              @default(0) @map("follow_ups")
  /// Cuándo toca insistir si la tienda no responde (días hábiles).
  followUpAt       DateTime?        @map("follow_up_at") @db.Timestamptz(6)
  repliedAt        DateTime?        @map("replied_at") @db.Timestamptz(6)
  /// Lo que falta del lado del usuario ("Deja el paquete en EnvíosYa") y hasta cuándo.
  nextStep         String?          @map("next_step")
  nextStepBy       DateTime?        @map("next_step_by") @db.Timestamptz(6)
  outcome          ReturnOutcome?
  /// Monto que se reclama y el que la tienda confirmó.
  amount           Decimal?         @db.Decimal(14, 2)
  refundAmount     Decimal?         @map("refund_amount") @db.Decimal(14, 2)
  currency         String           @default("USD") @db.Char(3)
  /// El dinero ya se vio en tus cuentas (movimiento a favor en Finanzas) o lo confirmaste tú.
  refundReceivedAt DateTime?        @map("refund_received_at") @db.Timestamptz(6)
  resolvedAt       DateTime?        @map("resolved_at") @db.Timestamptz(6)
  /// Historial: preparado, enviado, seguimientos, respuestas y reembolso (con ids de correos y acciones).
  events           Json             @default("[]")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  TrackedOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  action AgentAction? @relation(fields: [actionId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status, followUpAt])
  @@map("return_cases")
}
