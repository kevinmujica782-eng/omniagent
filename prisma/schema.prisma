  item WatchlistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, checkedAt(sort: Desc)])
  @@map("price_points")
}

/// Alerta inteligente: una bajada drástica (o el precio objetivo) con el resumen de Omni y la compra rápida.
model PriceAlert {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  itemId         String           @map("item_id") @db.Uuid
  status         PriceAlertStatus @default(NEW)
  price          Decimal          @db.Decimal(14, 2)
  previousPrice  Decimal?         @map("previous_price") @db.Decimal(14, 2)
  /// Precio de referencia: la mediana de los últimos 30 días (así un "descuento" tras subir el precio no cuenta).
  referencePrice Decimal?         @map("reference_price") @db.Decimal(14, 2)
  currency       String           @db.Char(3)
  dropPct        Int?             @map("drop_pct")
  /// DROP (bajada drástica), TARGET (llegó al objetivo), LOWEST (mínimo desde que se sigue)
  reasons        String[]         @default([])
  headline       String
  summary        String
  /// Opinión de Omni: buy (buen momento) o wait (conviene esperar).
  verdict        String?
  source         AnalysisSource   @default(RULES)
  /// Compra preparada desde la alerta (agent_actions).
  actionId       String?          @map("action_id") @db.Uuid
  expiresAt      DateTime?        @map("expires_at") @db.Timestamptz(6)
  seenAt         DateTime?        @map("seen_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  item WatchlistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt(sort: Desc)])
  @@index([itemId, createdAt(sort: Desc)])
  @@map("price_alerts")
}

/// Pedido creado al Permitir una compra en la hoja de pago. Hoy el cobro es simulado (sandbox).
