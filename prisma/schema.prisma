  connection IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([userId, startsAt])
  @@map("calendar_events")
}

// ───────────────────── Correo (trámites detectados) ─────────────────────

/// Correos sincronizados de la bandeja (solo lo necesario para detectar trámites) y su clasificación.
model MailMessage {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  connectionId   String          @map("connection_id") @db.Uuid
  externalId     String          @map("external_id")
  threadId       String?         @map("thread_id")
  folder         String          @default("inbox") // inbox | sent
  fromName       String?         @map("from_name")
  fromEmail      String          @map("from_email")
  toEmails       String[]        @default([]) @map("to_emails")
  subject        String
  snippet        String          @default("")
  bodyText       String          @default("") @map("body_text")
  receivedAt     DateTime        @map("received_at") @db.Timestamptz(6)
  isRead         Boolean         @default(false) @map("is_read")
  labels         String[]        @default([])
  // Clasificación: reglas o Claude
  category       MailCategory?
  importance     Int             @default(0) // 0 baja · 1 media · 2 alta
  triageSource   AnalysisSource? @map("triage_source")
  triagedAt      DateTime?       @map("triaged_at") @db.Timestamptz(6)
  summary        String?
  actionRequired Boolean         @default(false) @map("action_required")
  dueAt          DateTime?       @map("due_at") @db.Timestamptz(6)
